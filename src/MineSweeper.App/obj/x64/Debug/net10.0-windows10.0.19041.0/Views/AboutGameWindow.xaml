<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MineSweeper.App.Views.AboutGameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 尺寸与"关于 Windows"对话框一致（见 AboutWindowChrome），窄窗口下内容用滚动容纳 -->
    <Grid Padding="14" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock FontSize="19" FontWeight="SemiBold" Text="扫雷 2.0" />
            <TextBlock x:ConnectionId='8'
                x:Name="TaglineText"
                FontSize="12"
                TextWrapping="Wrap" />
            <TextBlock x:ConnectionId='9'
                x:Name="VersionText"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                         />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="7">
                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                <TextBlock x:ConnectionId='2'
                    x:Name="BodyText"
                    FontSize="12"
                    TextWrapping="Wrap" />
                <TextBlock x:ConnectionId='3'
                    x:Name="TechText"
                    FontSize="12"
                    TextWrapping="Wrap" />
                <TextBlock x:ConnectionId='4'
                    x:Name="StatsText"
                    FontSize="12"
                    TextWrapping="Wrap" />

                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                <TextBlock x:ConnectionId='5'
                    x:Name="RepoText"
                    FontSize="12"
                    TextWrapping="Wrap" />
                <TextBlock x:ConnectionId='6'
                    x:Name="LicenseText"
                    FontSize="12"
                    TextWrapping="Wrap" />

                <!-- 彩蛋（默认不可见，触发方式见 code-behind） -->
                <Border x:ConnectionId='7'
                    x:Name="EggCard"
                    Padding="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="🎉 隐藏彩蛋 · 十连击" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Text="你连点了版本号 10 下，一次雷都没踩到。" />
                        <TextBlock
                            FontSize="11"
                            Opacity="0.75"
                            TextWrapping="Wrap"
                            Text="这个彩蛋不会写进存档，也不会有人知道你来过。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

