<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MineSweeper.App.Views.AboutAuthorsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        Padding="14"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
            <!-- 主开发（头像本身是彩蛋 2 的触发点）；右侧是 Windows 平台图标（v1.5.1） -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <Grid Width="60" Height="60">
                        <Border
                            x:Name="PrimaryAvatarHost"
                            Width="60"
                            Height="60"
                            CornerRadius="30"
                            Tapped="OnPrimaryAvatarTapped">
                            <Border.Background>
                                <ImageBrush x:Name="PrimaryAvatarBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock
                            x:Name="PrimaryAvatarEggGlyph"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="26"
                            IsHitTestVisible="False"
                            Text="😎"
                            Visibility="Collapsed" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Fastrof" />
                        <TextBlock FontSize="12" Text="主开发 · Main Developer" />
                        <TextBlock
                            FontSize="11"
                            Opacity="0.7"
                            Text="核心引擎 · 渲染 · 关卡制 · 无障碍"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <Image
                    x:Name="WindowsImage"
                    Grid.Column="1"
                    Width="96"
                    Height="96"
                    Margin="12,0,2,0"
                    VerticalAlignment="Top"
                    Stretch="Uniform"
                    AutomationProperties.Name="Windows" />
            </Grid>

            <!-- 彩蛋 2 的奖励内容：默认不可见 -->
            <Border
                x:Name="EggCard"
                Padding="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel Spacing="3">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="😎 隐藏彩蛋 · 主开发模式" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Text="你给主开发戴上了墨镜。" />
                    <TextBlock
                        FontSize="12"
                        TextWrapping="Wrap"
                        Text="咦！我怎么看不见Bug了！刚好，休息一下，我想品尝一下“卡布奇诺”。你去找Shinichi吧~" />
                </StackPanel>
            </Border>

            <!-- Shinichi；右侧是 Linux/Tux 图标（v1.5.1） -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <Grid Width="60" Height="60">
                        <Border
                            x:Name="SecondaryAvatarHost"
                            Width="60"
                            Height="60"
                            CornerRadius="30"
                            Tapped="OnSecondaryAvatarTapped">
                            <Border.Background>
                                <ImageBrush x:Name="SecondaryAvatarBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock
                            x:Name="SecondaryAvatarEggGlyph"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="26"
                            IsHitTestVisible="False"
                            Text="🐛"
                            Visibility="Collapsed" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Shinichi" />
                        <TextBlock FontSize="12" Text="开发 · Developer" />
                        <TextBlock
                            FontSize="11"
                            Opacity="0.7"
                            Text="关于页面开发和UI优化"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <Image
                    x:Name="LinuxImage"
                    Grid.Column="1"
                    Width="96"
                    Height="96"
                    Margin="12,0,2,0"
                    VerticalAlignment="Top"
                    Stretch="Uniform"
                    AutomationProperties.Name="Linux" />
            </Grid>

            <!-- Shinichi 的大彩蛋：默认不可见 -->
            <Border
                x:Name="ShinichiEggCard"
                Padding="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel Spacing="3">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="🐛 大彩蛋 · Shinichi 的挑战" />
                    <TextBlock
                        FontSize="12"
                        TextWrapping="Wrap"
                        Text="Fastrof 戴着墨镜去喝卡布奇诺了，于是所有 bug 都归 Shinichi。" />
                    <TextBlock
                        FontSize="12"
                        TextWrapping="Wrap"
                        Text="他随手撒下 100 多颗雷，还不许你带道具。" />
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        Text="已解锁隐藏关卡「卡布奇诺」—— 去「关卡模式」最下面找它（只在本次运行有效）。" />
                </StackPanel>
            </Border>

            <!-- 顺序不对时的小彩蛋：先点 Shinichi 而不是 Fastrof 会出现这个（不解锁隐藏关） -->
            <Border
                x:Name="ShinichiTooEarlyCard"
                Padding="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel Spacing="3">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="😴 小彩蛋 · 来早了一步" />
                    <TextBlock
                        FontSize="12"
                        TextWrapping="Wrap"
                        Text="你连点了 Shinichi 五下。他抬起头看了你一眼：" />
                    <TextBlock
                        FontSize="12"
                        TextWrapping="Wrap"
                        Text="「Fastrof 还没跑路呢，bug 都还堆在他那儿。你先去把 Fastrof 送走，我这边才有活干。」" />
                </StackPanel>
            </Border>

            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!-- 贡献者（v1.4）：官方网页由 LLJ99999 重新设计。刻意没有 Tapped 事件，不参与任何彩蛋。 -->
            <TextBlock FontSize="14" FontWeight="SemiBold" Text="贡献者" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="60" Height="60" CornerRadius="30">
                    <Border.Background>
                        <ImageBrush x:Name="ContributorAvatarBrush" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel
                    MaxWidth="255"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="LLJ99999" />
                    <TextBlock FontSize="12" Text="贡献者 · 在校大学生" />
                    <TextBlock
                        FontSize="11"
                        Opacity="0.7"
                        Text="Minesweeper 2.0 官方网页全新重新设计"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

            <StackPanel Spacing="3">
                <TextBlock x:Name="FooterText" FontSize="12" TextWrapping="Wrap" />
                <TextBlock
                    x:Name="NoteText"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
